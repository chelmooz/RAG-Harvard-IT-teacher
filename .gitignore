# Prof IA — .gitignore

# Environnement
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Frontend
node_modules/
frontend/build/
frontend/.cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Data (trop lourd pour Git)
*.pdf
*.mp3
*.mp4
*.wav
*.docx
*.pptx
*.xlsx
*.gguf
/backend/data/
/backend/uploads/

# Docker
docker-compose.override.yml

# Logs
*.log

# Session / local agent state (never push to remote)
.omo/
# Campaign artifacts (T0.-1). run_matrix.sh defaults --out outside the repo,
# but an explicit --out inside it must not be committable.
profia-fit-artifacts/
scripts/benchmark/artifacts/
